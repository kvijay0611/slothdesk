# Copy to .env or set in your shell. NEVER commit real secrets.
SLOTHDESK_MODEL=qwen2.5:1.5b
SLOTHDESK_BASE_URL=http://127.0.0.1:11434
SLOTHDESK_PROVIDER=ollama
# Only needed for provider=openai (e.g. a closed-model baseline in evaluation):
# SLOTHDESK_API_KEY=
# SLOTHDESK_ALLOW_REMOTE=true

# Read scanned PDFs and photos of documents with local OCR (needs slothdesk[ocr]):
# SLOTHDESK_OCR=true
